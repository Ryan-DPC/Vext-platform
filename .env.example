# Local development configuration (Docker)
API_URL=http://localhost:3001
WS_URL=http://localhost:3002
WS_PORT=3002
PORT=3001
VITE_WEBSOCKET_URL=ws://localhost:3002
CENTRAL_WEBSOCKET_URL=http://localhost:3002

# Database
MONGODB_URI=mongodb://vext_mongo:27017/vext
REDIS_URL=redis://vext_redis:6379

# Cloudinary (replace with your own credentials)
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# JWT (REQUIRED - generate a strong random secret for production)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Games storage path
GAMES_LIBRARY_PATH=/mnt/storage/games

# PostgreSQL
POSTGRES_HOST=vext_postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vext_finance
POSTGRES_PORT=5432

# SSL (optional, for local HTTPS)
SSL_KEY_PATH=/app/ssl/key.pem
SSL_CERT_PATH=/app/ssl/cert.pem

# Frontend URL (for CORS, emails, etc.)
FRONTEND_URL=https://your-production-domain.com
