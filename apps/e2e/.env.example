# Target backend (defaults to local Elysia on 3001)
API_URL=http://localhost:3001

# Frontend Vite dev server (hash router)
BASE_URL=http://localhost:5173

# Optional: real account for authenticated smoke (@full)
# E2E_USER=player#abcd
# E2E_PASSWORD=secret

# Fail instead of skip when services are down (useful in dedicated CI)
# REQUIRE_API=0
# REQUIRE_UI=0
